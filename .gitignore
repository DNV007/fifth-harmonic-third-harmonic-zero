# Environments created by `uv sync` / `pip install -e .` in this directory.
# uv builds a ~700 MB .venv here; never commit it.
.venv/
venv/

# Python build and cache artifacts. hh_antiresonance.egg-info is regenerated by
# `uv sync`, so it is deliberately not tracked.
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

.DS_Store

# NOTE: data/ and figures/ ARE tracked. They are the deposited outputs, not
# build products -- the drivers regenerate them, but the archived copies are
# what the paper's numbers and figures were taken from.
